# Rename this file to .env and fill your real values

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kycFormDB?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://mitulbhimani281:mitulbhimani281@cluster0.t7dse.mongodb.net/kyc_database

# Port for the server
PORT=5001

# Your company name (shown on the form + generated PDF)
COMPANY_NAME=Your Company Pvt Ltd

# Admin login/session signing. Admin usernames and password hashes live in MongoDB.
ADMIN_AUTH_SECRET=<long-random-session-signing-secret>
ADMIN_COOKIE_SECURE=false

# DigiO server-to-server integration
DIGIO_BASE_URL=https://api.digio.in
DIGIO_CLIENT_ID=<digio-client-id>
DIGIO_CLIENT_SECRET=<digio-client-secret>
DIGIO_TOKEN_CLIENT_ID=<optional-token-client-id>
DIGIO_TOKEN_CLIENT_SECRET=<optional-token-client-secret>
DIGIO_TEMPLATE_NAME=KYC
DIGIO_TIMEOUT_MS=15000
# Set true to create a DigiO request after each successful local KYC save.
DIGIO_AUTO_REQUEST=false

# DigiSign agreement signing (server-to-server; keep credentials backend-only)
DIGISIGN_BASE_URL=https://ext.digio.in:444
DIGISIGN_CLIENT_ID=<digisign-client-id>
DIGISIGN_CLIENT_SECRET=<digisign-client-secret>
